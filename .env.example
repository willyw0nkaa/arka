# ====== WAJIB: Supabase (Project Settings → API) ======
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Boleh "anon" key lama atau "publishable" key baru (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Boleh "service_role" key lama atau "secret" key baru (sb_secret_...). JANGAN pernah dibagikan.
SUPABASE_SERVICE_ROLE_KEY=

# ====== WAJIB: URL aplikasi (untuk tautan persetujuan orang tua) ======
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ====== WAJIB: rahasia acak (bebas, minimal 32 karakter) ======
# Dipakai untuk ID pseudonim analitik & hash kode verifikasi
APP_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter
# Dipakai Vercel Cron untuk memanggil /api/cron/purge
CRON_SECRET=ganti-dengan-string-acak-lain

# ====== MODE DEMO ======
# true  = kode verifikasi & tautan persetujuan ditampilkan di layar (untuk demo/tugas tanpa layanan email)
# false = kode hanya dikirim lewat email (butuh RESEND_API_KEY)
DEMO_MODE=true

# ====== OPSIONAL: Email (https://resend.com) ======
RESEND_API_KEY=
EMAIL_FROM=ARKA <onboarding@resend.dev>

# ====== OPSIONAL: AI Companion ======
# Tanpa kunci ini, Companion memakai "mesin lokal" berbasis aturan + database karier.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
